{
  "expo": {
    "name": "cast-ads-app",
    "slug": "cast-ads-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cure.png",
    "scheme": "castadsapp",
    "platforms": ["ios", "android", "web"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cure.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.castadsapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/cure.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-dotenv",
        {
          "moduleName": "@env",
          "path": ".env",
          "safe": false,
          "allowUndefined": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}